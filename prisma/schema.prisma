generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("user")
  avatar    String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationRecord {
  id               String   @id @default(cuid())
  verificationId   String   @unique
  candidateName    String
  company          String
  verificationType String
  status           String   @default("pending")
  riskLevel        String   @default("low")
  submittedDate    DateTime @default(now())
  completionEta    DateTime?
  assigneeId       String?
  notes            String?
  chainHash        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  details   String?
  category  String   @default("general")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id              String   @id @default(cuid())
  candidateName   String
  candidatePhone  String?
  verificationId  String?
  status          String   @default("active")
  consentGiven    Boolean  @default(false)
  documentsUploaded String?
  lastActivity    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        ChatMessage[]
}

model ChatMessage {
  id              String   @id @default(cuid())
  sessionId       String
  type            String   @default("text")
  content         String
  isFromCandidate Boolean  @default(false)
  status          String   @default("sent")
  createdAt       DateTime @default(now())
  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DeepGuardCheck {
  id              String   @id @default(cuid())
  candidateName   String
  verificationId  String?
  status          String   @default("pending")
  challengeType   String?
  confidenceScore Float    @default(0)
  faceMatchScore  Float    @default(0)
  identityVerified Boolean @default(false)
  alerts          String?
  deepfakeScore   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LiveIDRecord {
  id              String   @id @default(cuid())
  candidateName   String
  idNumber        String?
  status          String   @default("pending")
  checkPassed     Boolean  @default(false)
  faceMatchScore  Float    @default(0)
  idMatchScore    Float    @default(0)
  livenessScore   Float    @default(0)
  antiSpoofScore  Float?
  photoCaptured   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NexusTaskRecord {
  id              String   @id @default(cuid())
  name            String
  type            String
  status          String   @default("pending")
  progress        Int      @default(0)
  candidateName   String?
  verificationId  String?
  logs            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
